{
  "name": "damon-agent",
  "version": "0.5.0",
  "description": "Damon agent core \u2014 local multi-provider agent daemon",
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/developjik/damon-agent-core",
  "homepage": "https://github.com/developjik/damon-agent-core#readme",
  "bugs": "https://github.com/developjik/damon-agent-core/issues",
  "bin": {
    "damond": "bin/damond",
    "damon": "bin/damon",
    "damon-telegram": "bin/damon-telegram",
    "damon-discord": "bin/damon-discord",
    "damon-slack": "bin/damon-slack",
    "damon-relay": "bin/damon-relay"
  },
  "scripts": {
    "postinstall": "node install.js",
    "test": "node --test client.test.mjs",
    "typecheck": "tsc --noEmit --strict --module nodenext --moduleResolution nodenext --allowImportingTsExtensions types-smoke.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "install.js",
    "client.mjs",
    "client.d.mts",
    "README.md",
    "bin/"
  ],
  "exports": {
    ".": {
      "types": "./client.d.mts",
      "default": "./client.mjs"
    }
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
