# damon-relay environment — copied to /etc/damon/relay.env (systemd)
# or loaded by docker compose. Generate the secret: openssl rand -hex 32

# Listen address. 0.0.0.0 accepts from any network interface;
# 127.0.0.1 only from the server itself (put TLS in front).
DAMON_RELAY_BIND=0.0.0.0:8080

# Registration secret — REQUIRED before going public. Daemons must
# present this exact value to register a tunnel; without it anyone
# can host tunnels on your server.
DAMON_RELAY_SECRET=change-me-openssl-rand-hex-32
